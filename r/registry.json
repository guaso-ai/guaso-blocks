{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "guaso",
  "homepage": "https://github.com/guaso-ai/guaso-blocks",
  "items": [
    {
      "name": "block-zone",
      "type": "registry:component",
      "title": "BlockZone",
      "description": "Renders schema-bound blocks; unknown types ignored; empty → null. Includes Block type + safeHref.",
      "files": [
        {
          "path": "registry/block-zone/block-zone.tsx",
          "type": "registry:component",
          "target": "@components/block-zone/block-zone.tsx"
        },
        {
          "path": "registry/block-zone/registry.ts",
          "type": "registry:component",
          "target": "@components/block-zone/registry.ts"
        },
        {
          "path": "registry/block-zone/types.ts",
          "type": "registry:component",
          "target": "@components/block-zone/types.ts"
        }
      ]
    },
    {
      "name": "blocks-from-entry",
      "type": "registry:component",
      "title": "blocksFromEntry",
      "description": "Maps a Guaso Content SDK entry (getEntry) to blocks[]. Empty-clear. CLI installs @guaso-ai/content (npm); does not copy HTTP client source.",
      "dependencies": ["@guaso-ai/content@^0.3.0"],
      "registryDependencies": ["@guaso/block-zone"],
      "files": [
        {
          "path": "registry/block-zone/blocks-from-entry.ts",
          "type": "registry:component",
          "target": "@components/block-zone/blocks-from-entry.ts"
        }
      ]
    },
    {
